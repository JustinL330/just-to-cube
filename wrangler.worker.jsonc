{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jus-cubing",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jus-cubing-accounts",
      "database_id": "5d31f008-3801-4be0-986c-fd99ba9b4a7c",
      "migrations_dir": "migrations"
    }
  ]
}
